{
  "manifest_version": 3,
  "name": "CaptionBoost - AI Subtitle Generator",
  "version": "1.1.0",
  "description": "CaptionBoost trasforma i tuoi video YouTube con sottotitoli AI intelligenti. Genera traduzioni accurate e personalizzate in tempo reale utilizzando l'intelligenza artificiale più avanzata. Perfetto per creator di contenuti, educatori e chiunque voglia rendere i propri video accessibili a un pubblico globale.",
  "permissions": ["scripting", "activeTab", "storage", "identity", "cookies"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost:3000/*",
    "http://localhost:3007/*",
    "https://captionboost.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CaptionBoost - AI Subtitles",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content-script.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "http://localhost:3007/*",
        "https://captionboost.vercel.app/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "settings.html",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
