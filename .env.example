# ==========================================
# CaptionBoost - Environment Configuration
# ==========================================
# Copia questo file come .env.local e compila i valori

# --- Supabase (Database + Auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Il login Google avviene tramite Supabase Auth: abilita il provider Google nel
# dashboard Supabase (Authentication > Providers > Google) con Client ID e Secret
# dell'app OAuth di Google Cloud, e registra in Google Cloud l'URI di redirect:
#   https://<your-project-ref>.supabase.co/auth/v1/callback

# --- Segreto JWT (auth estensione e route custom /api/auth/*) ---
# Genera: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=your_nextauth_secret_here

# --- Google OAuth (solo flusso custom estensione /api/auth/google) ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_pro=price_xxx
STRIPE_PRICE_team=price_xxx

# --- AI Engine & API Keys ---
# Motore predefinito per generare e tradurre i sottotitoli: Ollama locale con deepseek-r1.
# Nessuna API key richiesta per questa modalità (avvia "ollama serve" e "ollama pull deepseek-r1").
DEFAULT_AI_PROVIDER=ollama
DEFAULT_AI_MODEL=deepseek-r1

# URL del server Ollama locale
OLLAMA_API_URL=http://localhost:11434

# --- API Keys (percorso parallelo) ---
# Quando configuri un'API Key (nelle impostazioni dell'estensione o qui sul server),
# il sistema sceglie automaticamente il modello più adatto per i sottotitoli:
#   openai    -> gpt-4o-mini
#   gemini    -> gemini-2.0-flash
#   groq      -> llama-3.3-70b-versatile
#   anthropic -> claude-3-5-haiku-20241022
#   deepl     -> API DeepL
OPENAI_API_KEY=sk-proj-xxx
GEMINI_API_KEY=AIzaSy_xxx
GROQ_API_KEY=gsk_xxx
ANTHROPIC_API_KEY=sk-ant-xxx
DEEPL_API_KEY=your-deepl-api-key

# --- Extension API ---
NEXT_PUBLIC_EXTENSION_API=http://localhost:3000
EXTENSION_API_TIMEOUT=30000

# --- Debug ---
DEBUG_MODE=false

# --- SMTP (Email) ---
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="CaptionBoost" <noreply@captionboost.it>

# --- YouTube ---
YOUTUBE_API_KEY=your_youtube_api_key

# --- Defaults ---
DEFAULT_LANGUAGE=it